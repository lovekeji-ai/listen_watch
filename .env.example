# ── AI 结构化处理 ─────────────────────────────────────────────────

# 主 AI 服务：kimi / deepseek / claude
AI_PROVIDER=kimi
# 备用 AI 服务（主服务连续失败后自动切换）
AI_FALLBACK_PROVIDER=deepseek

# Kimi API 密钥（月之暗面）
KIMI_API_KEY=your_kimi_api_key_here
# DeepSeek API 密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Claude API 密钥（Anthropic）
ANTHROPIC_API_KEY=your_claude_api_key_here

# Voice Memos iCloud 同步目录（Mac 本地路径）
VOICE_MEMOS_DIR=/Users/yourname/Library/Group Containers/group.com.apple.VoiceMemos.shared/Recordings

# Obsidian Vault 根目录
OBSIDIAN_VAULT_DIR=/Users/yourname/path/to/your/obsidian/vault

# 日记文件夹绝对路径
OBSIDIAN_JOURNAL_DIR=/Users/yourname/path/to/your/obsidian/vault/Journal
# 日记文件名日期格式（默认 %Y-%m-%d，即 2026-02-28.md）
OBSIDIAN_DATE_FORMAT=%Y-%m-%d

# 超过此时长（分钟）的语音文件只记录，不进行转写；0 表示不限制
MAX_TRANSCRIBE_MINUTES=10

# 低于此时长（秒）的语音文件直接跳过转写
MIN_TRANSCRIBE_SECONDS=3

# ── 本地 Whisper 兜底 ─────────────────────────────────────────────
# 主转写（豆包）异常或仍返回空时，调用本地 faster-whisper 作为 fallback
# 留空 = 关闭兜底。Python 解释器需提前安装 faster-whisper

# 装有 faster-whisper 的 Python 解释器绝对路径（例如某个 venv 里的 python）
LOCAL_WHISPER_PYTHON=

# faster-whisper 模型名（如 large-v3 / large-v3-turbo / medium）
LOCAL_WHISPER_MODEL=large-v3

# 转写语言（zh / en / 留空让模型自动识别）
LOCAL_WHISPER_LANGUAGE=zh

# 单次本地转写最长等待秒数（large-v3 较大可适当放宽）
LOCAL_WHISPER_TIMEOUT=600

# ── 豆包语音转写（火山引擎）──────────────────────────────────────

# 控制台中的 App ID
VOLCENGINE_APP_ID=your_app_id

# 控制台中的 Access Token
VOLCENGINE_API_KEY=your_access_token

# 使用的模型版本：volc.bigasr.auc（1.0）或 volc.seedasr.auc（2.0）
VOLCENGINE_RESOURCE_ID=volc.bigasr.auc

# ── 阿里云 OSS（临时存储音频，转写完自动删除）────────────────────

# RAM 用户的 AccessKey ID
OSS_ACCESS_KEY_ID=your_access_key_id

# RAM 用户的 AccessKey Secret
OSS_ACCESS_KEY_SECRET=your_access_key_secret

# 存储桶名称
OSS_BUCKET_NAME=your_bucket_name

# 存储桶所在地域的 Endpoint，例：oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 临时文件在 OSS 中的目录前缀（可自定义，结尾需加 /）
OSS_TEMP_PREFIX=listen_watch_tmp/
